---
const year = new Date().getFullYear();
const socials = [
  { href: 'https://github.com/hartingsdev',    label: 'GitHub'   },
  { href: 'https://linkedin.com/in/robert-hartings/',  label: 'LinkedIn' },
  { href: 'https://xing.com/profile/Robert_Hartings', label: 'XING' },
  { href: '/imprint',                            label: 'Imprint'    },
  { href: '/datenschutz',                        label: 'Datenschutz' },
];
---
<footer class="border-t border-line mt-24">
  <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
    <span class="font-mono">© {year} Robert Hartings</span>
    <ul class="flex gap-6">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} class="hover:text-paper transition-colors" target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
